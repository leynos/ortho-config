source: cargo-orthohelp/tests/golden/redaction_artefact_tests.rs
expression: maml_en
---
﻿<?xml version="1.0" encoding="utf-8"?>
<helpItems schema="maml" xmlns:maml="http://schemas.microsoft.com/maml/2004/10" xmlns:command="http://schemas.microsoft.com/maml/dev/command/2004/10" xmlns:dev="http://schemas.microsoft.com/maml/dev/2004/10">
  <command:command>
    <command:details>
      <command:name>redaction_fixture</command:name>
      <maml:description>
        <maml:para>Redaction fixture command tree.</maml:para>
      </maml:description>
    </command:details>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>redaction_fixture</maml:name>
        <command:parameter required="false" position="named" variableLength="false">
          <maml:name>--region</maml:name>
          <command:parameterValue required="false">String</command:parameterValue>
        </command:parameter>
        <command:parameter required="false" position="named" variableLength="false">
          <maml:name>--mode</maml:name>
          <command:parameterValue required="false">String</command:parameterValue>
        </command:parameter>
        <command:parameter required="false" position="named" variableLength="false">
          <maml:name>--token</maml:name>
          <command:parameterValue required="false">String</command:parameterValue>
        </command:parameter>
        <command:parameter required="false" position="named" variableLength="false">
          <maml:name>--locator</maml:name>
          <command:parameterValue required="false">String</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters>
      <command:parameter required="false" position="named" variableLength="false">
        <maml:name>--region</maml:name>
        <maml:description>
          <maml:para>Region identifier served by the fixture.</maml:para>
          <maml:para>Short flag: -r.</maml:para>
          <maml:para>Long flag: --region.</maml:para>
          <maml:para>Default: String :: from(&quot;eu-west&quot;).</maml:para>
          <maml:para>Environment variable: REDACTION_FIXTURE_REGION.</maml:para>
          <maml:para>Config key: region.</maml:para>
        </maml:description>
        <command:parameterValue required="false">String</command:parameterValue>
      </command:parameter>
      <command:parameter required="false" position="named" variableLength="false">
        <maml:name>--mode</maml:name>
        <maml:description>
          <maml:para>Public mode advertised by the fixture.</maml:para>
          <maml:para>Short flag: -m.</maml:para>
          <maml:para>Long flag: --mode.</maml:para>
          <maml:para>Default: String :: from(&quot;fast&quot;).</maml:para>
          <maml:para>Possible values: fast, safe.</maml:para>
          <maml:para>Environment variable: REDACTION_FIXTURE_MODE.</maml:para>
          <maml:para>Config key: mode.</maml:para>
        </maml:description>
        <command:parameterValue required="false">String</command:parameterValue>
      </command:parameter>
      <command:parameter required="false" position="named" variableLength="false">
        <maml:name>--token</maml:name>
        <maml:description>
          <maml:para>Confidential token used by the fixture service.</maml:para>
          <maml:para>Long flag: --token.</maml:para>
          <maml:para>Environment variable: REDACTION_FIXTURE_TOKEN.</maml:para>
          <maml:para>Config key: token.</maml:para>
        </maml:description>
        <command:parameterValue required="false">String</command:parameterValue>
      </command:parameter>
      <command:parameter required="false" position="named" variableLength="false">
        <maml:name>--locator</maml:name>
        <maml:description>
          <maml:para>Locator the application resolves elsewhere.</maml:para>
          <maml:para>Long flag: --locator.</maml:para>
          <maml:para>Environment variable: REDACTION_FIXTURE_LOCATOR.</maml:para>
          <maml:para>Config key: locator.</maml:para>
        </maml:description>
        <command:parameterValue required="false">String</command:parameterValue>
      </command:parameter>
      <command:commonParameters />
    </command:parameters>
  </command:command>
</helpItems>
